generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ChannelRole {
  OWNER
  MODERATOR
  MEMBER
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  status        String?   @default("online") @db.VarChar(20)
  bio           String?   @db.VarChar(500)
  role          Role      @default(MEMBER)
  deactivatedAt DateTime?
  tokenVersion  Int       @default(0)
  lastSeen      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  messages     Message[]
  channels     ChannelMember[]
  reactions    Reaction[]
  dmReactions  DMReaction[]
  sentDMs      DirectMessage[] @relation("SentMessages")
  receivedDMs  DirectMessage[] @relation("ReceivedMessages")
  channelReads ChannelRead[]
}

model Channel {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(80)
  isPrivate  Boolean   @default(false)
  createdBy  Int?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  messages Message[]
  members  ChannelMember[]
  reads    ChannelRead[]
}

model ChannelMember {
  userId    Int
  channelId Int
  role      ChannelRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model Message {
  id        Int       @id @default(autoincrement())
  content   String
  userId    Int
  channelId Int
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reactions    Reaction[]
  channelReads ChannelRead[] @relation("ChannelReadMessage")

  @@index([channelId, createdAt])
}

model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  userId    Int
  messageId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

model DirectMessage {
  id         Int       @id @default(autoincrement())
  content    String
  fromUserId Int
  toUserId   Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  editedAt   DateTime?
  deletedAt  DateTime?
  readAt     DateTime?

  fromUser  User         @relation("SentMessages", fields: [fromUserId], references: [id])
  toUser    User         @relation("ReceivedMessages", fields: [toUserId], references: [id])
  reactions DMReaction[]

  @@index([fromUserId, toUserId])
  @@index([toUserId, fromUserId])
}

model DMReaction {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  userId    Int
  dmId      Int
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id])
  dm   DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)

  @@unique([userId, dmId, emoji])
  @@index([dmId])
}

model ChannelRead {
  id                Int      @id @default(autoincrement())
  userId            Int
  channelId         Int
  lastReadMessageId Int?
  updatedAt         DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadMessage Message? @relation("ChannelReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, channelId])
}
