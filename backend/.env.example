# Database connection string
# For production (Neon/Supabase), append ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/srlko"

# JWT secret - REQUIRED in production, must be at least 32 chars
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Server port (Railway auto-sets this in production)
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# CORS origin - defaults to http://localhost:5173 in development
# In production set explicitly, e.g. https://srlko.vercel.app
# Supports comma-separated list for multi-origin: https://a.com,https://b.com
# CORS_ORIGIN=
